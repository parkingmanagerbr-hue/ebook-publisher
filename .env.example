# ============================================================
# GENIA EbookPublisher — Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Servidor
DASHBOARD_PORT=3100
JWT_SECRET=genia-ebook-secret-mude-em-producao

# Gemini
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.0-flash

# Cerebras (modelo: qwen-3-235b-a22b-instruct-2507 ou llama3.1-8b)
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=
CEREBRAS_API_KEY_5=
CEREBRAS_API_KEY_6=

# SambaNova
SAMBANOVA_API_KEY=
SAMBANOVA_API_KEY_2=
SAMBANOVA_API_KEY_3=
SAMBANOVA_API_KEY_4=
SAMBANOVA_API_KEY_5=
SAMBANOVA_API_KEY_6=

# Groq (https://console.groq.com)
GROQ_API_KEY=

# Outros providers
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
FAL_AI_API_KEY=

# Ollama local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VPS_SSH_ALIAS=vps
OLLAMA_VPS_CONTAINER_IP=172.17.0.1
OLLAMA_VPS_MODEL=llama3.1:8b
OLLAMA_VPS_TUNNEL_PORT=11435

# Publicacao - Cakto
CAKTO_EMAIL=
CAKTO_PASSWORD=

# Publicacao - Hotmart
HOTMART_EMAIL=
HOTMART_PASSWORD=

# Publicacao - Amazon KDP
# ATENCAO: conta deve ter dados bancarios e fiscais preenchidos manualmente
KDP_EMAIL=
KDP_PASSWORD=
KDP_AUTHOR_NAME=GENIA Editorial

# Configuracoes gerais
EBOOK_PRICE=4.99
AUTHOR_NAME=GENIA Editorial
PUBLISH_INTERVAL_HOURS=24
AUTO_PUBLISH=false
HEADLESS=true

# VPS / Docker
DOMAIN=seudominio.com
