# ============================================================
# GENIA EbookPublisher — Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
DASHBOARD_PORT=3100
JWT_SECRET=genia-ebook-secret-mude-em-producao

# ── Gemini (https://aistudio.google.com/app/apikey) ─────────
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-2.0-flash
# Chave dedicada para geracao de capas (evita esgotar cota das chaves de texto)
GEMINI_COVER_KEY=

# ── Cerebras (https://cloud.cerebras.ai) ────────────────────
# Modelo: qwen-3-235b-a22b-instruct-2507 ou llama3.1-8b
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=
CEREBRAS_API_KEY_5=
CEREBRAS_API_KEY_6=

# ── SambaNova (https://cloud.sambanova.ai) ───────────────────
SAMBANOVA_API_KEY=
SAMBANOVA_API_KEY_2=
SAMBANOVA_API_KEY_3=
SAMBANOVA_API_KEY_4=
SAMBANOVA_API_KEY_5=
SAMBANOVA_API_KEY_6=
SAMBANOVA_API_KEY_7=
SAMBANOVA_API_KEY_8=

# ── Groq (https://console.groq.com) ─────────────────────────
GROQ_API_KEY=
# Modelo opcional (padrao: llama-3.3-70b-versatile)
GROQ_MODEL=

# ── Claude / Anthropic (https://console.anthropic.com) ──────
# Usado pelo claudeDesignAgent (capas com Claude)
ANTHROPIC_API_KEY=

# ── Outros providers de texto ────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_2=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_KEY_2=
HUGGINGFACE_API_KEY_3=
HUGGINGFACE_API_KEY_4=
FAL_AI_API_KEY=

# ── Ollama local (fallback sem limite) ───────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VPS_SSH_ALIAS=vps
OLLAMA_VPS_CONTAINER_IP=172.17.0.1
OLLAMA_VPS_MODEL=llama3.1:8b
OLLAMA_VPS_TUNNEL_PORT=11435

# ── Publicacao — Cakto (https://app.cakto.com.br) ───────────
CAKTO_EMAIL=
CAKTO_PASSWORD=

# ── Publicacao — Hotmart (https://app.hotmart.com) ───────────
HOTMART_EMAIL=
HOTMART_PASSWORD=

# ── Publicacao — Amazon KDP (https://kdp.amazon.com) ────────
# ATENCAO: conta deve ter dados bancarios e fiscais preenchidos manualmente
KDP_EMAIL=
KDP_PASSWORD=
KDP_AUTHOR_NAME=GENIA Editorial
# Preco em USD (minimo $0.99). Amazon converte automaticamente para BRL.
KDP_PRICE_USD=0.99
# Amazon Associates tag (para links de afiliado da Amazon)
AMAZON_AFFILIATE_TAG=

# ── Configuracoes do Agente Autonomo ────────────────────────
# Preco dos ebooks nas plataformas BR
EBOOK_PRICE=4.99
AUTHOR_NAME=GENIA Editorial

# Intervalo entre geracoes em MINUTOS (0 = modo continuo, sem pausa)
# Ex: 60 = 1 ebook/hora, 180 = 1 ebook/3h, 0 = continuo
GENERATE_INTERVAL_MINUTES=180

# Idiomas separados por virgula (rotacao sequencial)
# Ex: pt-BR,en,es,fr,de,it,pl,nl,ja,zh
EBOOK_LANGUAGES=pt-BR

# Iniciar agente em modo pausado (true/false)
AGENT_PAUSED=false

# Publicacao automatica por plataforma (true/false)
AUTO_PUBLISH=true
AUTO_PUBLISH_HOTMART=true
AUTO_PUBLISH_CAKTO=true
AUTO_PUBLISH_AMAZON=false

# Tentar servicos web gratuitos (Gamma/Piktochart/ebookmaker/Visme) antes do pipeline normal
# true = web primeiro (168 ebooks/mes gratis) | false = pipeline normal sempre
WEB_EBOOK_FIRST=true

# Rodar em modo somente dashboard (sem agente autonomo — usa megaAgent.js separado)
DASHBOARD_ONLY=0

# Headless Puppeteer (true em producao, false para debug local)
HEADLESS=true

# Caminho do Chrome para Puppeteer (deixe vazio para usar bundled Chromium)
# Ex Linux: /usr/bin/google-chrome-stable
# Ex Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_EXECUTABLE=

# Pular geracao de ilustracoes nos capitulos (true = mais rapido, false = com imagens)
# Padrao: true — ilustracoes usam cota do Pollinations/HuggingFace; pular economiza tempo
SKIP_ILLUSTRATIONS=true

# Gerar audiobook apos cada ebook gerado (true/false)
# Requer Edge TTS instalado: pip install edge-tts
GENERATE_AUDIOBOOK=false

# ── OTP / 2FA — Email para leitura automatica de codigos IMAP ──
# Necessario para Cakto (2FA por email). Use senha de app, nao a senha principal.
# Gmail: myaccount.google.com/apppasswords
# Outlook: account.microsoft.com/security → App passwords
OTP_IMAP_HOST=imap.gmail.com
OTP_IMAP_PORT=993
OTP_IMAP_USER=
OTP_IMAP_PASSWORD=

# Hotmail/Outlook OTP (alternativa ao IMAP — para conta mrovariz@hotmail.com)
HOTMAIL_EMAIL=
HOTMAIL_PASSWORD=

# ── VPS / Docker ─────────────────────────────────────────────
DOMAIN=seudominio.com
VPS_IP=
RUNNING_ON_VPS=false
# Numero de CPUs da VPS (usado para calcular threshold de carga)
VPS_CPU_COUNT=2

# Diretorio de dados (padrao: /app/data em Docker, ./data localmente)
# Deixe vazio para usar o padrao automatico
DATA_DIR=

# Diretorio de screenshots de debug (Puppeteer)
SCREENSHOTS_DIR=

# Redis URL (opcional — para filas BullMQ em vez de in-memory)
# Ex: redis://localhost:6379
REDIS_URL=

# Intervalo de verificacao de sessoes em horas (padrao: 2)
SESSION_CHECK_HOURS=2

# Intervalo em horas para rodar o pipeline de afiliados (padrao: 24)
AFFILIATE_RUN_INTERVAL_HOURS=24

# ── Landing Pages — Cloudflare DNS ──────────────────────────
# Necessario para criar subdominios automaticamente (afiliados/landing pages)
# Dashboard: dash.cloudflare.com → dominio → Overview → Zone ID
# Token: dash.cloudflare.com → Profile → API Tokens → Edit zone DNS
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
BASE_DOMAIN=seudominio.com.br

# ── Landing Pages — Deploy na Nuvem (alternativa ao VPS) ────
# Vercel: vercel.com/account/tokens
VERCEL_TOKEN=

# Netlify: app.netlify.com/user/applications → Personal access tokens
NETLIFY_TOKEN=
# ID do site Netlify existente (opcional — deixe vazio para criar novo site)
NETLIFY_SITE_ID=

# Forcao deploy em nuvem mesmo quando VPS esta disponivel
# true = sempre usa Vercel->Netlify | false = VPS quando carga < threshold
FORCE_CLOUD_DEPLOY=false

# Limite de carga do VPS para fallback automatico para nuvem (0.0 a 1.0)
VPS_LOAD_THRESHOLD=0.70

# Caminhos Nginx no VPS (usado quando FORCE_CLOUD_DEPLOY=false e VPS disponivel)
NGINX_DATA_PATH=/opt/platform/data/veloxisit
NGINX_CONF_PATH=/opt/platform/nginx/sites

# ── ElevenLabs — Audiobooks (opcional) ──────────────────────
# Necessario para gerar audiobooks de alta qualidade
# Sem chave: usa Edge TTS (Microsoft, gratuito, qualidade menor)
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=
ELEVENLABS_API_KEY_4=
# ID da voz (padrao: Adam pNInz6obpgDQGcFmaJgB | ver: elevenlabs.io/voice-library)
ELEVENLABS_VOICE_ID=
# Modelo (padrao: eleven_multilingual_v2)
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Servicos Web de Ebook (Gamma, Piktochart, ebookmaker, Visme) ──
# Contas Gmail para gerar ebooks gratuitos (ate 168/mes)
# Execute: node scripts/setup-web-sessions.js para configurar sessoes
# Separadas por virgula, em ordem de prioridade
GMAIL_ACCOUNTS=

# Limite mensal de geracoes por conta por servico (ajuste conforme seu plano)
GAMMA_MONTHLY_LIMIT=8
PIKTOCHART_MONTHLY_LIMIT=5
EBOOKMAKER_MONTHLY_LIMIT=10
VISME_MONTHLY_LIMIT=5

# ── Geracao de imagens (capas e ilustracoes) ─────────────────
# Higgsfield AI — FLUX Pro Kontext Max (melhor qualidade)
# Formato: KEY_ID:KEY_SECRET (obtido em platform.higgsfield.ai)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_KEY_2=
HIGGSFIELD_API_KEY_3=
HIGGSFIELD_API_KEY_4=
HIGGSFIELD_API_KEY_5=
HIGGSFIELD_API_KEY_6=

# Together.xyz — FLUX.1-schnell (rapido, free tier disponivel)
# https://api.together.xyz
TOGETHER_API_KEY=

# Cloudflare AI — FLUX.1-schnell gratis (conta Cloudflare necesaria)
# https://dash.cloudflare.com -> AI -> Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── Sessoes salvas (caminho) ─────────────────────────────────
# Onde salvar sessoes do browser exportadas pelo setup-*.js
# Deixe vazio para usar o padrao: data/sessions/
HOTMART_SESSION_FILE=
